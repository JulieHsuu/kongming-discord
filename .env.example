# ===== 必填 =====
# Discord Developer Portal → 你的應用程式 → Bot → Reset Token
DISCORD_TOKEN=

# 孔明的大腦：anthropic（Claude API）或 openai（任何 OpenAI 相容端點，例如自架模型、Hermes 用的端點）
KM_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 用 OpenAI 相容端點時填這兩個（自架端點不需要金鑰可留空）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 模型（不填就用預設值）
# KM_MODEL=claude-sonnet-5-5               一般交辦與文件
# KM_MODEL_HEAVY=claude-opus-5-5           提案簡報、Demo、計畫書
# KM_MODEL_FAST=claude-haiku-4-5-20251001  判斷群組對話要不要主動動手（呼叫最頻繁）

# ===== 建議填 =====
# 對外網址：手機可直接打開 Demo、播放影片、下載超過 Discord 上限的檔案
# 例如 https://kongming.datafabric.iii-ei-stack.com（反向代理到這台的 8787 埠）
PUBLIC_BASE_URL=

# 只在這些 Discord 伺服器工作（伺服器 ID，逗號分隔；預設安全設定下必填，空白時不回應任何伺服器）
KM_GUILD_IDS=
# 孔明主動觀察的頻道 ID（逗號分隔；空白＝所有看得到的文字頻道）
KM_WATCH_CHANNELS=

# ===== 主動做事的方式 =====
# auto：符合職能時主動把工作做好；ask：先問大家再做；off：只在被叫到時工作（各頻道可用 /孔明 模式 調整）
KM_DEFAULT_MODE=auto
# auto 模式下可直接做的工作
KM_AUTO_TASKS=prep,ingest,debrief,status,match,poc,deck,proposal,research,roi
# 一定先問的工作（比較花時間或比較貴）
KM_ASK_TASKS=demo,video,closeout
# 對話停下多少秒後，孔明才判斷要不要動手
KM_OBSERVE_DELAY_SEC=60
# 同一頻道兩次判斷之間至少隔幾秒
KM_OBSERVE_MIN_GAP_SEC=180
# 判斷信心門檻（0–1，越高越保守）
KM_CONFIDENCE=0.72
# 每個伺服器每天最多主動做幾次
KM_DAILY_PROACTIVE_LIMIT=15
# 同一案件同一項工作，幾小時內不重做（有新資訊除外）
KM_DEDUPE_HOURS=12
# 這段時間不主動動手（例如 22-7），被叫到仍會回應
KM_QUIET_HOURS=22-7
# 主動工作的成果放在討論串裡，避免洗版
KM_USE_THREADS=true
KM_ALLOW_DM=true

# ===== 其他 =====
TZ=Asia/Taipei
PORT=8787
KM_DISCORD_UPLOAD_MB=10
KM_VIDEO_FPS=24
KM_ORG=資策會數位轉型研究院
# 啟動時把 assets/avatar.png 設成孔明的頭像（只需要做一次）
KM_SET_AVATAR=false

# ===== 錄音轉逐字稿（Whisper 相容端點，二選一） =====
# A. OpenAI：只填金鑰即可（模型 whisper-1，或 gpt-4o-transcribe）
# B. 公司自架 faster-whisper／whisper.cpp server（資料不出公司，建議）：填網址，金鑰可留空
KM_STT_BASE_URL=
KM_STT_API_KEY=
KM_STT_MODEL=whisper-1
# 每段長度（秒）、單檔最長分鐘數、單檔最大 MB
KM_STT_CHUNK_SEC=600
KM_STT_MAX_MINUTES=180
KM_STT_MAX_MB=200
# 辨識後用模型整理成繁體中文、補標點、分段（不刪減內容）
KM_STT_CLEANUP=true

# ===== 資安 =====
# 沒設 KM_GUILD_IDS 時，孔明拒絕所有伺服器（建議保持 true）
KM_REQUIRE_GUILD_LIST=true
# 可以使用孔明的身分組 ID（逗號分隔；空白＝伺服器內所有成員）
KM_ALLOWED_ROLES=
# 可確認對外產出、資料異動、切換模式的身分組 ID（空白＝同上）
KM_ADMIN_ROLES=
# 孔明完全不讀、不回的頻道 ID（例如人事、財務、主管頻道）
KM_EXCLUDE_CHANNELS=
# 每人每小時最多交辦幾次
KM_USER_RATE_PER_HOUR=30
# 一般附件大小上限（MB）
KM_MAX_ATTACH_MB=25
# 送模型前遮蔽身分證號、卡號、帳密、金鑰
KM_REDACT=true
# 婉拒與顧問工作無關的問題
KM_STRICT_SCOPE=true
# 產出檔案與下載連結保存天數；群組對話保存天數
KM_FILE_TTL_DAYS=30
KM_TRANSCRIPT_DAYS=14

# ===== 工作節奏 =====
# 每日提醒與週報發到這個頻道（頻道 ID）
KM_BRIEF_CHANNEL=
# 每個工作日早上的提醒時間；拜訪日、待辦期限、科專截止日前幾天提醒
KM_BRIEF_TIME=08:50
KM_REMIND_DAYS=3,1,0
KM_WORKDAYS_ONLY=true
# 週報：星期幾（1=一 … 5=五）、幾點
KM_WEEKLY_DAY=5
KM_WEEKLY_TIME=17:00
# 企業研究時上網查（使用 Claude API 的 web search 工具；自架模型時自動關閉）
KM_WEB_SEARCH=true

# ===== 每日商機專欄 =====
# 專欄發到哪個頻道（空白＝同 KM_BRIEF_CHANNEL）
KM_SCOUT_CHANNEL=
KM_SCOUT_TIME=10:00
# idle：近 3 天沒有拜訪才寫；daily：每個工作日都寫；off：只在被叫到時寫
KM_SCOUT_WHEN=idle
# 團隊這陣子想推的方向（孔明挑對象會優先考慮）
KM_SCOUT_FOCUS=製造業 AI 檢測與預測維護、餐飲零售數位化、地方政府與法人的產業 AI 推動計畫
# 專欄附上可操作的 Demo
KM_SCOUT_DEMO=true
# 查政府電子採購網公開標案（g0v 開放 API）
KM_TENDER_SEARCH=true
KM_TENDER_API=https://pcc-api.openfun.app/api
# 每天最多替幾位訂閱的顧問各寫一篇專屬推薦（沒有人訂閱時寫一篇團隊版）
KM_SCOUT_MAX_USERS=8

# ===== 治理（委員會意見後新增）=====
# 設成 true 等於全院緊急停止（也可以用 /孔明管理 緊急停止）
KM_KILL=false
# 對外產出要由「交辦人以外」的顧問確認
KM_FOUR_EYES=true
# 每月模型預算（美元，0＝不設上限）；達 100% 停止高成本的主動工作
KM_MONTHLY_BUDGET_USD=0
# 每百萬 tokens 單價（美元），用來估算費用；不填只統計 tokens
KM_PRICE_IN=
KM_PRICE_OUT=
KM_PRICE_HEAVY_IN=
KM_PRICE_HEAVY_OUT=
KM_PRICE_FAST_IN=
KM_PRICE_FAST_OUT=
# 每項工作估計節省的分鐘數（成效報告用，請依實測校正）
KM_MINUTES_SAVED=prep:60,ingest:15,debrief:45,status:15,match:40,poc:120,deck:180,demo:240,video:240,proposal:480,research:60,roi:90,closeout:30,scout:120,outreach:30
# 科專資料超過幾天沒檢核就在結果上警示
KM_KZ_STALE_DAYS=14
# 機密案件改用的自架模型（OpenAI 相容），資料不出公司
KM_PRIVATE_LLM_BASE=
KM_PRIVATE_LLM_KEY=
KM_PRIVATE_LLM_MODEL=
# 成效儀表板 /dashboard?token=… 的密語（不填則關閉）
KM_DASHBOARD_TOKEN=
# 推薦政府單位：allow｜ask（做簡報前要管理員確認利益迴避）｜off
KM_SCOUT_AGENCY=ask
# 推薦時平衡地區與企業規模
KM_SCOUT_DIVERSITY=true
# 院內客戶名冊（撞客戶與利益迴避檢查）：放在 state/clients.csv
#   欄位：企業名稱,統一編號,負責單位,負責人,狀態,關係,備註

# ===== 7/24 維運 =====
# 告警、每日健康報告、重啟通知發到這個頻道（頻道 ID，建議只給管理員看）
KM_ADMIN_CHANNEL=
KM_HEALTH_TIME=08:30

# ===== 老顧問、團隊協作、個資（第 4–11 輪）=====
# 這些產出完成後自我查核（沒有依據、和案件資料矛盾、過度承諾）；留空＝關閉
KM_FACTCHECK=deck,proposal,outreach
# 每天私訊提醒同事被指派、快到期或逾期的待辦
KM_TODO_DM=true
# 採用商機後幾天沒有聯繫紀錄就提醒
KM_FOLLOWUP_DAYS=3
# 第一次互動時說明孔明會記什麼、怎麼查看與刪除
KM_PRIVACY_NOTICE=true
# 老顧問經驗包：data/playbooks.json（可在 state/playbooks.json 放院內版本覆蓋）
# 院內知識庫：state/kb/（同事在 Discord 說「收進知識庫」，或管理員直接放 .md／.txt）
# 院內協作單位名冊：state/capabilities.csv（格式見 samples/capabilities.csv）
# 可以看團隊看板（/孔明管理 團隊）的主管身分組 ID，逗號分隔；空白＝只有管理員
KM_MANAGER_ROLES=
# 誰可以把文件收進院內知識庫：all（有權限的同事）｜admin（只有管理員）
KM_KB_WRITE=all
